{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/readable-patent-generator/disclosure_model.schema.json",
  "title": "Structured Patent Disclosure Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_manifest",
    "evidence_registry",
    "data_registry",
    "formula_registry",
    "term_registry",
    "figure_registry",
    "sections",
    "cross_references",
    "pending_items"
  ],
  "properties": {
    "contract_version": {"const": "3.0"},
    "source_manifest": {"type": "array", "items": {"type": "object"}},
    "evidence_registry": {"type": "object"},
    "data_registry": {"type": "array", "items": {"type": "object"}},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "content": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "formula_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "formula_registry": {"$ref": "formula_registry.schema.json"},
    "term_registry": {"type": "array", "items": {"type": "object"}},
    "figure_registry": {"type": "array", "items": {"type": "object"}},
    "cross_references": {"type": "array", "items": {"type": "object"}},
    "pending_items": {"type": "array", "items": {"type": "object"}}
  }
}
