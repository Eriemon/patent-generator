{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/readable-patent-generator/disclosure_model.schema.json",
  "title": "Structured Patent Disclosure Model 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_manifest",
    "evidence_registry",
    "data_registry",
    "formula_registry",
    "term_registry",
    "figure_registry",
    "sections",
    "cross_references",
    "pending_items",
    "feature_registry",
    "rule_applicability",
    "semantic_review",
    "migration",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": "4.0"
    },
    "source_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "required": ["source_id", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["invention_evidence", "prior_art", "template_admin"]}
        }
      }
    },
    "evidence_registry": {
      "type": "object",
      "required": ["records"],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "anyOf": [
              {"required": ["evidence_id"]},
              {"required": ["id"]}
            ],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "data_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "required": ["data_id"],
        "properties": {
          "data_id": {"type": "string", "minLength": 1},
          "approved": {"type": "boolean"},
          "decision": {"enum": ["accept", "reject", "pending"]}
        }
      }
    },
    "formula_registry": {
      "$ref": "formula_registry.schema.json"
    },
    "term_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "figure_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content", "evidence_ids", "data_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "data_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "formula_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "required": ["status"],
        "properties": {
          "status": {"enum": ["open", "closed"]}
        }
      }
    },
    "feature_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "text",
          "section_ids",
          "evidence_ids",
          "technical_effects"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^FT(?:[0-9]{3,}|[A-F0-9]{64})$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "section_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "technical_effects": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "rule_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_applicability"],
      "properties": {
        "ai_applicability": {
          "enum": ["applicable", "not_applicable", "pending", "disputed"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_reviews",
        "human_confirmations",
        "pending_reviews",
        "pending_confirmations"
      ],
      "properties": {
        "agent_reviews": {
          "type": "array",
          "items": {"$ref": "#/$defs/agent_review"}
        },
        "human_confirmations": {
          "type": "array",
          "items": {"$ref": "#/$defs/human_confirmation"}
        },
        "agent_review_history": {
          "type": "array",
          "items": {"$ref": "#/$defs/agent_review"}
        },
        "human_confirmation_history": {
          "type": "array",
          "items": {"$ref": "#/$defs/human_confirmation"}
        },
        "pending_reviews": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "pending_confirmations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "source_contract_version", "input_sha256"],
      "properties": {
        "state": {"enum": ["native", "pending", "complete"]},
        "source_contract_version": {"type": "string", "minLength": 1},
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claims_source_contract_version": {"type": "string", "minLength": 1},
        "claims_state": {"enum": ["pending", "complete"]},
        "claims_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claims_companion": {"type": "string", "minLength": 1},
        "batch_id": {"type": "string", "pattern": "^MB[0-9a-f]{32}$"},
        "receipt_id": {"type": "string", "pattern": "^MR[0-9a-f]{32}$"},
        "receipt_file": {"type": "string", "pattern": "^[^/\\\\]+\\.json$"},
        "pending_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "claims_map": {"type": "object"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "artifact_role",
        "producer",
        "case_id",
        "parent_model_sha256",
        "root_model_sha256",
        "draft_sha256",
        "preview_sha256",
        "claims_sha256",
        "chain"
      ],
      "properties": {
        "state": {"enum": ["pending", "sealed"]},
        "artifact_role": {"enum": ["initial", "reviewed"]},
        "producer": {"enum": ["model4_pipeline", "record_semantic_review"]},
        "case_id": {"type": "string", "minLength": 1},
        "root_model_path": {"const": "03_drafts/latest_disclosure_model.json"},
        "parent_model_path": {"type": "string", "pattern": "^03_drafts/[^/]+\\.json$"},
        "parent_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preview_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "claims_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "parent_model_path",
              "parent_model_sha256",
              "child_model_path"
            ],
            "properties": {
              "record_id": {"type": "string", "minLength": 1},
              "parent_model_path": {"type": "string", "pattern": "^03_drafts/[^/]+\\.json$"},
              "parent_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "child_model_path": {"type": "string", "pattern": "^03_drafts/[^/]+\\.json$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "review_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enablement",
        "mechanism",
        "causal_effect",
        "terminology",
        "evidence_consistency"
      ],
      "properties": {
        "enablement": {"const": true},
        "mechanism": {"const": true},
        "causal_effect": {"const": true},
        "terminology": {"const": true},
        "evidence_consistency": {"const": true}
      }
    },
    "agent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "target_type",
        "target_id",
        "target_hash",
        "verdict",
        "coverage"
      ],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "target_type": {"enum": ["section", "feature", "model"]},
        "target_id": {"type": "string", "minLength": 1},
        "target_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_content": {},
        "evidence_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verdict": {"enum": ["pass", "revise", "block"]},
        "coverage": {"$ref": "#/$defs/review_coverage"},
        "actor": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "minLength": 1},
        "supersedes": {"type": "string", "minLength": 1},
        "superseded_by": {"type": "string", "minLength": 1}
      }
    },
    "human_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"confirmation_type": {"const": "governed_fact"}},
            "required": ["confirmation_type"]
          },
          "then": {"properties": {"target_type": {"const": "data"}}}
        },
        {
          "if": {
            "properties": {"confirmation_type": {"const": "independent_claim_feature_set"}},
            "required": ["confirmation_type"]
          },
          "then": {"properties": {"target_type": {"const": "independent_claim"}}}
        },
        {
          "if": {
            "properties": {"confirmation_type": {"const": "ai_applicability"}},
            "required": ["confirmation_type"]
          },
          "then": {"properties": {"target_type": {"const": "ai_applicability"}}}
        },
        {
          "if": {
            "properties": {"confirmation_type": {"const": "feature_technical_effect"}},
            "required": ["confirmation_type"]
          },
          "then": {"properties": {"target_type": {"const": "feature_technical_effect"}}}
        }
      ],
      "required": [
        "confirmation_id",
        "confirmation_type",
        "target_type",
        "target_id",
        "target_hash",
        "decision"
      ],
      "properties": {
        "confirmation_id": {"type": "string", "minLength": 1},
        "confirmation_type": {
          "enum": [
            "governed_fact",
            "independent_claim_feature_set",
            "ai_applicability",
            "feature_technical_effect"
          ]
        },
        "target_type": {"enum": ["data", "independent_claim", "ai_applicability", "feature_technical_effect"]},
        "target_id": {"type": "string", "minLength": 1},
        "target_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_content": {},
        "evidence_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision": {"enum": ["confirm", "reject"]},
        "actor": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "minLength": 1},
        "supersedes": {"type": "string", "minLength": 1},
        "superseded_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
