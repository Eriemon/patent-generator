{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/readable-patent-generator/examination_quality_contract.schema.json",
  "title": "Examination Quality Contract 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "effective_from",
    "sources",
    "profiles",
    "ai_scopes",
    "levels",
    "rules"
  ],
  "properties": {
    "contract_version": {"const": "2.0"},
    "effective_from": {"const": "2026-01-01"},
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "edition", "role", "effective_from", "source_note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "edition": {"type": "string", "minLength": 1},
          "role": {"enum": ["base", "amendment", "interpretation"]},
          "effective_from": {"type": "string", "format": "date"},
          "url": {"type": "string", "minLength": 1},
          "source_note": {"type": "string", "minLength": 1}
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["general", "ai_algorithm"]},
      "allOf": [
        {"contains": {"const": "general"}},
        {"contains": {"const": "ai_algorithm"}}
      ]
    },
    "ai_scopes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["model_training", "model_application", "both"]},
      "allOf": [
        {"contains": {"const": "model_training"}},
        {"contains": {"const": "model_application"}},
        {"contains": {"const": "both"}}
      ]
    },
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["blocker", "major", "minor"]},
      "allOf": [
        {"contains": {"const": "blocker"}},
        {"contains": {"const": "major"}},
        {"contains": {"const": "minor"}}
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "handler_id",
          "rule_sets",
          "default_level",
          "evidence_required",
          "applicability"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "handler_id": {"type": "string", "pattern": "^[a-z]+(?:_[a-z]+)*$"},
          "rule_sets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z]+(?:_[a-z]+)*$"}
          },
          "default_level": {"enum": ["blocker", "major", "minor"]},
          "evidence_required": {"type": "boolean"},
          "applicability": {"$ref": "#/$defs/applicability"}
        }
      }
    }
  },
  "$defs": {
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["always", "signal", "ai_rules"]},
        "signal_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["hard", "soft", "none"]}
        },
        "ai_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["model_training", "model_application", "both"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "always"}}, "required": ["mode"]},
          "then": {
            "properties": {"mode": {"const": "always"}},
            "maxProperties": 1
          }
        },
        {
          "if": {"properties": {"mode": {"const": "signal"}}, "required": ["mode"]},
          "then": {
            "required": ["signal_levels"],
            "properties": {"mode": {"const": "signal"}},
            "minProperties": 2,
            "maxProperties": 2
          }
        },
        {
          "if": {"properties": {"mode": {"const": "ai_rules"}}, "required": ["mode"]},
          "then": {
            "properties": {"mode": {"const": "ai_rules"}},
            "maxProperties": 2,
            "not": {"required": ["signal_levels"]}
          }
        }
      ]
    }
  }
}
