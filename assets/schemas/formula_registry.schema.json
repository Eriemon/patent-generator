{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/readable-patent-generator/formula_registry.schema.json",
  "title": "Formula Registry",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["formula_id", "display_number", "latex", "purpose", "sources", "references", "symbols", "inputs", "output", "assumptions", "constraints", "content_hash"],
    "properties": {
      "formula_id": {"type": "string", "pattern": "^F[0-9]{3,}$"},
      "display_number": {"type": "string", "minLength": 1},
      "latex": {"type": "string", "minLength": 1},
      "purpose": {"type": "string", "minLength": 1},
      "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "symbols": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "meaning", "unit", "domain"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "meaning": {"type": "string", "minLength": 1},
            "unit": {"type": "string", "minLength": 1},
            "domain": {"type": "string", "minLength": 1}
          }
        }
      },
      "inputs": {"type": "array", "items": {"type": "string"}},
      "output": {"type": "string"},
      "assumptions": {"type": "array", "items": {"type": "string"}},
      "constraints": {"type": "array", "items": {"type": "string"}},
      "derivation": {"type": "string"},
      "example": {"type": "string"},
      "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
