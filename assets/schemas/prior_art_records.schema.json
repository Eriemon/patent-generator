{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "publication_no_or_title",
          "verified",
          "same_features",
          "different_features",
          "difference_effects",
          "actual_technical_problem",
          "technical_motivation"
        ],
        "properties": {
          "publication_no_or_title": {"type": "string", "minLength": 1},
          "verified": {"const": true},
          "same_features": {"type": "array", "items": {"type": "string"}},
          "different_features": {"type": "array", "items": {"type": "string"}},
          "difference_effects": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "actual_technical_problem": {"type": "string", "minLength": 1},
          "technical_motivation": {
            "type": "object",
            "required": ["conclusion", "evidence"],
            "properties": {
              "conclusion": {"type": "string", "minLength": 1},
              "evidence": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
                ]
              }
            }
          }
        }
      }
    }
  }
}
