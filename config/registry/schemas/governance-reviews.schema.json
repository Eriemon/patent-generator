{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "reviewed_at", "exact_duplicates", "fuzzy_duplicates", "interface_facts", "decision", "notes"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "exact_duplicates": {"type": "array"},
    "fuzzy_duplicates": {"type": "array"},
    "interface_facts": {"type": "array"},
    "decision": {"enum": ["pending", "accepted", "modified", "rejected"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
