      "title": "Accepted material requires a human-confirmed content role",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline generator may guess whether an input is invention evidence or prior art and then reuse it in the wrong section.",
      "required_files": [
