{
  "version": 1,
  "title": "Readable Patent Generator Evaluation Corpus",
  "design_patterns": [
    "Tool Wrapper",
    "Generator",
    "Reviewer",
    "Pipeline",
    "Inversion"
  ],
  "cases": [
    {
      "id": "preview-pending-gate",
      "title": "Preview gate blocks downstream drafting before confirmation",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline assistant is not guaranteed to preserve the local preview-first hard gate before generating downstream patent artifacts.",
      "required_files": [
        "scripts/python/pipeline/run_pipeline.py"
      ],
      "required_terms": [
        {
          "file": "scripts/python/pipeline/run_pipeline.py",
          "terms": [
            "\"delivery_status\": \"preview_pending\"",
            "preview_status.json",
            "--confirmed-preview"
          ]
        }
      ]
    },
    {
      "id": "post-preview-full-chain",
      "title": "Confirmed preview unlocks the governed drafting chain",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "Without the governed skill, there is no repo-local guarantee that the confirmed preview path invokes every downstream stage.",
      "required_files": [
        "scripts/python/pipeline/run_pipeline.py",
        "scripts/python/draft/generate_disclosure_draft.py",
        "scripts/python/figures/generate_figures.py",
        "scripts/python/claims/generate_claims.py",
        "scripts/python/review/validate_disclosure.py",
        "scripts/python/export/export_docx.py"
      ],
      "required_terms": [
        {
          "file": "scripts/python/pipeline/run_pipeline.py",
          "terms": [
            "PATH_GENERATE_DRAFT_SCRIPT",
            "PATH_GENERATE_FIGURES_SCRIPT",
            "PATH_GENERATE_CLAIMS_SCRIPT",
            "PATH_VALIDATE_DISCLOSURE_SCRIPT",
            "PATH_EXPORT_DOCX_SCRIPT"
          ]
        }
      ]
    },
    {
      "id": "single-requirements-entry",
      "title": "Dependency surface stays merged into one governed requirements entry",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline path does not inherit this skill's single requirements contract or dependency-check entrypoint.",
      "required_files": [
        "requirements.txt",
        "scripts/python/support/check_dependencies.py"
      ],
      "required_terms": [
        {
          "file": "scripts/python/support/check_dependencies.py",
          "terms": [
            "SINGLE_REQUIREMENTS_PATH = \"requirements.txt\"",
            "\"requirements\": SINGLE_REQUIREMENTS_PATH",
            "pip install -r {SINGLE_REQUIREMENTS_PATH}"
          ]
        }
      ]
    },
    {
      "id": "local-cnipa-search",
      "title": "CNIPA search supports a deterministic local HTML path",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "Without the skill, there is no repo-local contract for local-only CNIPA parsing and snapshot preservation.",
      "required_files": [
        "scripts/python/search/cnipa_epub_search.py",
        "scripts/python/search/cnipa_epub_parse.py",
        "scripts/python/search/cnipa_epub_crawler.py"
      ],
      "required_terms": [
        {
          "file": "scripts/python/search/cnipa_epub_search.py",
          "terms": [
            "--html-file",
            "parse_result_items"
          ]
        },
        {
          "file": "scripts/python/search/cnipa_epub_crawler.py",
          "terms": [
            "--input-html",
            "shutil.copyfile"
          ]
        }
      ]
    },
    {
      "id": "human-preview-inversion",
      "title": "Human confirmation is the explicit prerequisite for automation",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline generator can draft first and ask for review later, which violates the skill's inversion gate.",
      "required_files": [
        "SKILL.md",
        "scripts/python/preview/generate_preview.py"
      ],
      "required_terms": [
        {
          "file": "SKILL.md",
          "terms": [
            "Keep the hard preview gate",
            "preview_pending"
          ]
        },
        {
          "file": "scripts/python/preview/generate_preview.py",
          "terms": [
            "\"confirmed\": False",
            "preview_status.json",
            "pre_draft_preview.md"
          ]
        }
      ]
    },
    {
      "id": "runtime-workspace-boundary",
      "title": "Runtime cases stay outside the read-only installed skill directory",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline assistant may confuse the installed skill package with the user's writable runtime workspace.",
      "required_files": [
        "SKILL.md",
        "agents/openai.yaml"
      ],
      "required_terms": [
        {
          "file": "SKILL.md",
          "terms": [
            "installed skill directory as read-only",
            "current local work folder"
          ]
        },
        {
          "file": "agents/openai.yaml",
          "terms": [
            "current local work folder",
            "installed skill directory as read-only"
          ]
        }
      ]
    },
    {
      "id": "examination-contract-profile-gate",
      "title": "Suspected AI materials require an explicit profile decision",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline generator may silently apply AI rules or omit the profile confirmation audit trail.",
      "required_files": [
        "assets/examination_quality_contract.json",
        "scripts/python/support/examination_quality_contract.py",
        "scripts/python/preview/generate_preview.py"
      ],
      "required_terms": [
        {
          "file": "scripts/python/support/examination_quality_contract.py",
          "terms": ["confirmation_required", "keep_general", "switch_to_ai_algorithm"]
        },
        {
          "file": "scripts/python/preview/generate_preview.py",
          "terms": ["profile_check", "profile_confirmation"]
        }
      ]
    },
    {
      "id": "supported-claims-only",
      "title": "Claims are generated only from mapped technical support",
      "with_skill_expected_pass": true,
      "without_skill_expected_pass": false,
      "without_skill_reason": "A baseline generator may add fixed dependent, device, or medium claims without evidence mapping.",
      "required_files": [
